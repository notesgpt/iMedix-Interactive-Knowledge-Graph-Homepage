{
  "name": "imedix-knowledge-universe-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Front-end bundle for the iMedix Knowledge Universe WordPress plugin.",
  "scripts": {
    "fixture": "php ../bin/build-graph.php --drugs=../tests/fixtures/sheets/drugs.csv --diseases=../tests/fixtures/sheets/diseases.csv --redirects=../tests/fixtures/sheets/redirects.csv --out=public/dev/graph.full.json --report=public/dev/report.json --generated-at=2026-10-27T00:00:00Z && php ../bin/render-preview.php",
    "dev": "npm run fixture && vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "e2e": "node ../tests/e2e/run.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
