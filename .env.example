# The plugin needs NO secrets in the default mode (CSV export of the link-shared sheet).
#
# Optional: Google Sheets API mode. Put the key in wp-config.php (preferred) or the
# server environment — never in the database, the theme, or front-end code.
#   define( 'IMEDIX_KU_SHEETS_API_KEY', 'AIza…' );
# Restrict the key in Google Cloud Console to the Sheets API and to the server's egress IPs.
IMEDIX_KU_SHEETS_API_KEY=

# Local integration tests only (tests/wordpress/run.sh)
WP_ZIP=/path/to/wordpress-6.5.zip
SQLITE_ZIP=/path/to/sqlite-database-integration.zip
WP_CLI=/path/to/wp-cli.phar
